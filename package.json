{
  "name": "www-nicolasjouanno-com",
  "engines": {
    "pnpm": "10.x",
    "node": "24.x"
  },
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio de Nicolas Jouanno",
  "packageManager": "pnpm@10.34.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jn-prod/www-nicolasjouanno-com"
  },
  "author": "nicolas jouanno",
  "license": "MIT",
  "homepage": "https://www.nicolasjouanno.com",
  "scripts": {
    "dev": "pnpm build && python3 -m http.server -d ./_site",
    "build": "pnpm build:images && pnpm check:positioning && pnpm check:content-images && pnpm sync:icons && bundle exec jekyll build && pnpm copy:images",
    "build:images": "pnpm build:images:prepare && pnpm build:images:raster && pnpm build:images:svg",
    "build:images:prepare": "rm -rf ./images-dist && mkdir ./images-dist && cp -R ./images-src/. ./images-dist/",
    "build:images:raster": "sharp -i './images-dist/**/*.{jpg,jpeg,png}' -o {dir} -f webp && find ./images-dist -type f \\( -name '*.jpg' -o -name '*.jpeg' -o -name '*.png' \\) -delete",
    "build:images:svg": "svgo -r -f ./images-dist -o ./images-dist",
    "check:positioning": "ruby scripts/check-positioning.rb",
    "check:content-images": "ruby scripts/check-content-images.rb",
    "sync:icons": "mkdir -p ./_includes/icons && cp ./images-dist/icons/*.svg ./_includes/icons/",
    "copy:images": "cp -R ./images-dist ./_site/images && ruby scripts/copy-legacy-image-aliases.rb",
    "lint": "pnpm lint:es && pnpm lint:stylelint && pnpm lint:prettier",
    "lint:fix": "pnpm lint:es:fix && pnpm lint:stylelint:fix && pnpm lint:prettier:fix",
    "lint:stylelint": "stylelint \"./_sass/**/*.scss\"",
    "lint:stylelint:fix": "pnpm lint:stylelint --fix",
    "lint:prettier": "prettier --check **/*.{html,md,json,yml}",
    "lint:prettier:fix": "pnpm lint:prettier --write",
    "lint:es": "eslint 'assets/**/*.js'",
    "lint:es:fix": "pnpm lint:es --fix"
  },
  "dependencies": {
    "modern-normalize": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@shopify/prettier-plugin-liquid": "^1.10.2",
    "eslint": "^10.0.0",
    "eslint-config-jnprod": "latest",
    "globals": "^17.0.0",
    "prettier": "latest",
    "sharp": "^0.35.0",
    "sharp-cli": "^5.2.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "svgo": "^4.0.1",
    "typescript-eslint": "^8.59.1"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=11.1.0",
      "fast-uri": ">=3.1.2",
      "brace-expansion@5": ">=5.0.6"
    }
  }
}
