---
layout: null
permalink: /substack.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <language>fr</language>
    <title>{{ site.title | xml_escape }} — archive complète</title>
    <description>Archive intégrale des publications de nicolasjouanno.com.</description>
    <link>{{ site.url }}</link>
    <atom:link href="{{ site.url }}/substack.xml" rel="self" type="application/rss+xml"/>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>

    {% for post in site.posts %}
      {% include substack-import-item.xml post=post %}
    {% endfor %}
  </channel>
</rss>
