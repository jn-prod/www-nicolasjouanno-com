---
layout: null
permalink: /substack-import.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <language>fr</language>
    <title>{{ site.title | xml_escape }} — récits</title>
    <description>Extraits des récits publiés sur nicolasjouanno.com.</description>
    <link>{{ site.url }}/recits.html</link>
    <atom:link href="{{ site.url }}/substack-import.xml" rel="self" type="application/rss+xml"/>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>

    {% assign recits = site.posts | where: "format", "recit" %}
    {% for post in recits %}
      {% unless post.archive == true or post.categories contains "Work" %}
      {% include substack-import-item.xml post=post %}
      {% endunless %}
    {% endfor %}
  </channel>
</rss>
