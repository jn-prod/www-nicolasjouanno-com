---
layout: null
---
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": "{{ site.title | escape }}",
  "home_page_url": "{{ site.url }}",
  "feed_url": "{{ site.url }}/feed.json",
  "description": "{{ site.description | escape }}",
  "language": "fr",
  "author": {
    "name": "{{ site.author.name | escape }}",
    "url": "{{ site.url }}",
    "avatar": "{{ site.url }}/{{ site.author.avatar }}"
  },
  "items": [
    {% include feed-order.html %}
    {% for feed_key in feed_keys %}
    {% assign feed_index = feed_key | remove_first: "s" | remove_first: "p" | plus: 0 %}
    {% if feed_key contains "s" %}
    {% assign entry = site.data.substack[feed_index] %}
    {
      "id": {{ entry.url | jsonify }},
      "url": {{ entry.url | jsonify }},
      "title": {{ entry.title | jsonify }},
      "summary": {{ entry.description | truncatewords: 50 | jsonify }},
      "content_text": {{ entry.description | jsonify }},
      "date_published": "{{ entry.date | date_to_xmlschema }}",
      {% if entry.image %}
      "image": "{{ entry.image | absolute_url }}",
      {% endif %}
      "tags": ["la-sortie"]
    }{% unless forloop.last %},{% endunless %}
    {% continue %}
    {% endif %}
    {% assign post = feed_site[feed_index] %}
    {% capture absolute_src %}src="{{ site.url }}/{% endcapture %}
    {% capture absolute_href %}href="{{ site.url }}/{% endcapture %}
    {% capture feed_content %}
      <p><em>Initialement publié sur <a href="{{ site.url }}{{ post.url }}">nicolasjouanno.com</a>.</em></p>
      {% if post.image %}
      <p><a href="{{ site.url }}{{ post.url }}"><img src="{{ post.image | absolute_url }}" alt="{{ post.image_alt | default: post.title | escape }}"/></a></p>
      {% endif %}
      {{ post.content | replace: 'src="/', absolute_src | replace: 'href="/', absolute_href }}
    {% endcapture %}
    {
      "id": "{{ site.url }}{{ post.url }}",
      "url": "{{ site.url }}{{ post.url }}",
      "title": {{ post.title | jsonify }},
      "content_html": {{ feed_content | jsonify }},
      "summary": {{ post.excerpt | strip_html | truncatewords: 50 | jsonify }},
      "date_published": "{{ post.date | date_to_xmlschema }}",
      {% if post.last_modified_at %}
      "date_modified": "{{ post.last_modified_at | date_to_xmlschema }}",
      {% endif %}
      {% if post.image %}
      "image": "{{ post.image | absolute_url }}",
      {% endif %}
      "tags": [{% for tag in post.tags %}{{ tag | jsonify }}{% if forloop.last == false %}, {% endif %}{% endfor %}]
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
