---
layout: null
permalink: /la-sortie/editions.json
---
{%- assign editions = site.tags["la-sortie"] | where: "category", "newsletter" -%}
{%- capture absolute_src %}src="{{ site.url }}/{% endcapture -%}
{%- capture absolute_href %}href="{{ site.url }}/{% endcapture -%}
{
  "editions": [
    {%- for post in editions %}
    {
      "title": {{ post.title | jsonify }},
      "description": {{ post.description | jsonify }},
      "date": {{ post.date | date_to_xmlschema | jsonify }},
      "month": {{ post.url | split: "/" | last | jsonify }},
      "url": {{ post.url | prepend: site.url | jsonify }},
      "image": {{ post.image | absolute_url | jsonify }},
      "image_alt": {{ post.image_alt | jsonify }},
      "image_caption": {{ post.image_caption | markdownify | remove: '<p>' | remove: '</p>' | strip | jsonify }},
      "content": {{ post.content | replace: 'src="/', absolute_src | replace: 'href="/', absolute_href | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
